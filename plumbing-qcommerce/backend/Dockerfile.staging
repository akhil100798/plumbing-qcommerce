# Multi-stage build for FixKart Spring Boot Staging backend with Tailscale userspace networking
FROM eclipse-temurin:17-jdk-alpine AS builder
WORKDIR /app
COPY .mvn .mvn
COPY mvnw pom.xml ./
RUN chmod +x mvnw && ./mvnw dependency:go-offline -q
COPY src ./src
RUN ./mvnw clean package -DskipTests -q

FROM eclipse-temurin:17-jre-alpine AS runtime
WORKDIR /app

# Install runtime dependencies:
# - tailscale: WireGuard userspace client
# - socat: TCP-to-SOCKS5 bridge
# - postgresql18-client: psql CLI matching host database for validation
# - ca-certificates, curl, netcat-openbsd: networking and health inspection
RUN apk add --no-cache \
    tailscale \
    socat \
    postgresql18-client \
    ca-certificates \
    curl \
    netcat-openbsd \
    iproute2

# Copy application jar from builder
COPY --from=builder /app/target/plumbing-core-0.0.1-SNAPSHOT.jar app.jar

# Copy staging entrypoint and probe scripts
COPY entrypoint-staging.sh /app/entrypoint-staging.sh
COPY staging-tunnel-probe.sh /app/staging-tunnel-probe.sh
COPY verify-spring-boot-staging.sh /app/verify-spring-boot-staging.sh
RUN chmod +x /app/entrypoint-staging.sh /app/staging-tunnel-probe.sh /app/verify-spring-boot-staging.sh

EXPOSE 10000

ENV PORT=10000
ENV SPRING_PROFILES_ACTIVE=staging
ENV DATABASE_URL=jdbc:postgresql://127.0.0.1:15432/fixkart_staging_local

ENTRYPOINT ["/app/entrypoint-staging.sh"]
CMD ["java", "-Xmx400m", "-Xms256m", "-XX:+UseContainerSupport", "-XX:MaxRAMPercentage=75.0", "-jar", "app.jar"]
