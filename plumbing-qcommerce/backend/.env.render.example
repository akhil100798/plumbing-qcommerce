SPRING_PROFILES_ACTIVE=prod,staging
PORT=10000
APP_SCHEDULING_ENABLED=false
APP_DEMO_SEED_ENABLED=true
APP_MOBILE_DEMO_SEED_ENABLED=true

DATABASE_URL=jdbc:postgresql://REPLACE_RENDER_INTERNAL_HOST:5432/REPLACE_DB
DATABASE_USERNAME=REPLACE_USER
DATABASE_PASSWORD=REPLACE_PASSWORD

JWT_SECRET=replace-with-long-random-secret-minimum-32-chars
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3100,http://localhost:3101,http://localhost:19006,http://localhost:19007,http://localhost:19008,http://localhost:19009,https://admin-portal-ten-weld.vercel.app
SMS_PROVIDER=disabled

REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL=false

MONGO_URI=

KAFKA_BOOTSTRAP_SERVERS=
KAFKA_USERNAME=
KAFKA_PASSWORD=
KAFKA_SECURITY_PROTOCOL=
KAFKA_SASL_MECHANISM=

OTP_HASH_SECRET=replace-with-long-random-secret-minimum-32-chars
OTP_LENGTH=6
OTP_EXPIRY_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_VERIFY_ATTEMPTS=5
OTP_DEMO_BYPASS_ENABLED=false
OTP_DEMO_CODE=

APP_SEED_DEMO_ENABLED=false
APP_SEED_CATALOG_ENABLED=false
APP_SEED_ADMIN_DEMO_ENABLED=false
APP_SEED_FAIL_IF_PROD_DEMO_ENABLED=true
APP_SEED_DEMO_PASSWORD=

# ------------------------------------------------------------------
# STAGING-ONLY QA SEED VARIABLES
# Set these in the Development-2 / staging Render service ONLY.
# DO NOT enable in the production service.
# ------------------------------------------------------------------
# Activates StagingDemoMobileUserSeeder (creates *.qa@fixkart.com accounts,
# QA Store, plumber KYC, catalog categories/products/stock).
APP_SEED_MOBILE_QA_ENABLED=false

# Activates StagingDemoAdminUserSeeder (creates admin.qa@fixkart.com + legacy admin accounts).
APP_SEED_STAGING_ADMIN_ENABLED=false

# Activates CatalogDataSeeder (requires staging profile, creates base catalog).
APP_SEED_CATALOG_ENABLED=false

# QA seed password — set a strong value in Render, never commit the real value here.
APP_SEED_DEMO_PASSWORD=

FEATURE_DELIVERY_ENABLED=false
